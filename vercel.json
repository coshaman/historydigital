{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:v33",
  "outputDirectory": "dist-v33",
  "functions": {
    "api/rpg/[...path].js": {
      "maxDuration": 30
    },
    "api/rpg/health.js": {
      "maxDuration": 30
    },
    "api/rpg/session/start.js": {
      "maxDuration": 30
    },
    "api/rpg/dialogue.js": {
      "maxDuration": 30
    }
  }
}
